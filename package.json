{
  "name": "zhelf",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix packages/shared run build && npm --prefix apps/web run build",
    "test": "npm --prefix apps/web run test",
    "emulators:start": "docker compose up -d postgres",
    "emulators:stop": "docker compose down",
    "emulators:clean": "node ./scripts/clean-emulators.mjs",
    "db:migrate": "node ./scripts/apply-supabase-migrations.mjs"
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}
